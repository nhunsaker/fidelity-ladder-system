{
  "$description": "Primer-derived primitive scale (GitHub light mode) — the paint. Sorb is the engine: these flow through Style Dictionary into variables.css + a flat TokenSet for @sorb/leaf's SorbProvider. Values match github.com's Primer primitives; the v1 static lens already hand-used them.",
  "color": {
    "white": { "$value": "#ffffff", "$type": "color" },
    "gray": {
      "0": { "$value": "#f6f8fa", "$type": "color" },
      "1": { "$value": "#eaeef2", "$type": "color" },
      "3": { "$value": "#d1d9e0", "$type": "color" },
      "5": { "$value": "#59636e", "$type": "color" },
      "9": { "$value": "#1f2328", "$type": "color" }
    },
    "blue": {
      "0": { "$value": "#ddf4ff", "$type": "color" },
      "5": { "$value": "#0969da", "$type": "color" },
      "6": { "$value": "#0550ae", "$type": "color" }
    },
    "green": {
      "0": { "$value": "#dafbe1", "$type": "color" },
      "5": { "$value": "#1a7f37", "$type": "color" }
    },
    "yellow": {
      "0": { "$value": "#fff8c5", "$type": "color" },
      "6": { "$value": "#9a6700", "$type": "color" }
    },
    "red": {
      "0": { "$value": "#ffebe9", "$type": "color" },
      "5": { "$value": "#cf222e", "$type": "color" }
    },
    "purple": {
      "0": { "$value": "#fbefff", "$type": "color" },
      "5": { "$value": "#8250df", "$type": "color" }
    }
  },
  "radius": {
    "control": { "$value": "6px", "$type": "dimension" },
    "pill": { "$value": "20px", "$type": "dimension" }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" }
  }
}
